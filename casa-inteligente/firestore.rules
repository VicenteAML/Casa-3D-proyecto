rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function usuarioAutorizado() {
      return request.auth != null
        && request.auth.uid == 'tObszVM0VwNvHMh5CZAmvFWnGPq1';
    }

    function eventoValido() {
      return request.resource.data.keys().hasAll(['ts', 'unidad', 'tipo', 'ciclos', 'delta'])
        && request.resource.data.keys().hasOnly(['ts', 'unidad', 'tipo', 'ciclos', 'delta'])
        && request.resource.data.ts is timestamp
        && request.resource.data.unidad is string
        && request.resource.data.tipo is string
        && request.resource.data.ciclos is int
        && request.resource.data.delta is int;
    }

    match /eventos/{id} {
      allow read: if usuarioAutorizado();
      allow create, update: if usuarioAutorizado() && eventoValido();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
